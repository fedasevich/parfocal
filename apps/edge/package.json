{
  "name": "@parfocal/edge",
  "description": "The Cloudflare Worker router, tile gateway and Durable Objects",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./capability": "./src/capability.ts",
    "./room-client": "./src/room-client.ts",
    "./tiles": "./src/tiles.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.src.json && tsc --noEmit -p tsconfig.test.json",
    "test": "node --test \"test/**/*.test.ts\""
  },
  "imports": {
    "#*": "./src/*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261006.1",
    "@parfocal/typescript-config": "workspace:*",
    "wrangler": "4.161.0"
  }
}
