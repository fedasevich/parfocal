{
  "$schema": "https://unpkg.com/wrangler@4/config-schema.json",
  "name": "parfocal-edge-dev",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "dependencies_instrumentation": { "enabled": false },
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "r2_buckets": [{ "binding": "SLIDES", "bucket_name": "parfocal-dev" }],
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "Room" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "ratelimits": [
    { "name": "LOGIN_LIMIT", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "UPLOAD_LIMIT", "namespace_id": "1002", "simple": { "limit": 120, "period": 60 } },
    { "name": "TILE_LIMIT", "namespace_id": "1003", "simple": { "limit": 1000, "period": 10 } },
    { "name": "ROOM_LIMIT", "namespace_id": "1004", "simple": { "limit": 300, "period": 60 } },
    {
      "name": "ROOM_INTERNAL_LIMIT",
      "namespace_id": "1005",
      "simple": { "limit": 3000, "period": 60 }
    }
  ],
  "env": {
    "production": {
      "name": "parfocal-edge",
      "workers_dev": false,
      "routes": [{ "pattern": "app.parfocal.eu", "custom_domain": true }],
      "r2_buckets": [{ "binding": "SLIDES", "bucket_name": "parfocal-dev" }],
      "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "Room" }] },
      "ratelimits": [
        { "name": "LOGIN_LIMIT", "namespace_id": "2001", "simple": { "limit": 10, "period": 60 } },
        {
          "name": "UPLOAD_LIMIT",
          "namespace_id": "2002",
          "simple": { "limit": 120, "period": 60 }
        },
        { "name": "TILE_LIMIT", "namespace_id": "2003", "simple": { "limit": 1000, "period": 10 } },
        { "name": "ROOM_LIMIT", "namespace_id": "2004", "simple": { "limit": 300, "period": 60 } },
        {
          "name": "ROOM_INTERNAL_LIMIT",
          "namespace_id": "2005",
          "simple": { "limit": 3000, "period": 60 }
        }
      ]
    },
    "staging": {
      "name": "parfocal-edge-staging",
      "workers_dev": false,
      "routes": [{ "pattern": "staging.parfocal.eu", "custom_domain": true }],
      "r2_buckets": [{ "binding": "SLIDES", "bucket_name": "parfocal-staging" }],
      "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "Room" }] },
      "ratelimits": [
        { "name": "LOGIN_LIMIT", "namespace_id": "3001", "simple": { "limit": 10, "period": 60 } },
        {
          "name": "UPLOAD_LIMIT",
          "namespace_id": "3002",
          "simple": { "limit": 120, "period": 60 }
        },
        { "name": "TILE_LIMIT", "namespace_id": "3003", "simple": { "limit": 1000, "period": 10 } },
        { "name": "ROOM_LIMIT", "namespace_id": "3004", "simple": { "limit": 300, "period": 60 } },
        {
          "name": "ROOM_INTERNAL_LIMIT",
          "namespace_id": "3005",
          "simple": { "limit": 3000, "period": 60 }
        }
      ]
    }
  }
}
