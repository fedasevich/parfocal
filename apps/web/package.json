{
  "name": "@parfocal/web",
  "description": "The pathologist web app (React SPA)",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.src.json && tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p tsconfig.node.json",
    "test": "node --test \"test/**/*.test.ts\"",
    "build": "vite build",
    "dev": "vite",
    "dev:fake": "PARFOCAL_PUBLIC_APP_ENV=dev PARFOCAL_PUBLIC_FAKE_API=all vite",
    "test:browser": "playwright test"
  },
  "imports": {
    "#*": "./src/*"
  },
  "dependencies": {
    "@parfocal/api-client": "workspace:*",
    "@parfocal/tokens": "workspace:*",
    "@parfocal/ui": "workspace:*",
    "@parfocal/viewer-engine": "workspace:*"
  },
  "devDependencies": {
    "@parfocal/typescript-config": "workspace:*",
    "vite": "8.3.3",
    "msw": "3.0.3",
    "@playwright/test": "1.64.0"
  }
}
