{
  "name": "@parfocal/web",
  "description": "The pathologist web app (React SPA)",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.src.json && tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p tsconfig.node.json",
    "test": "node --test \"test/**/*.test.ts\"",
    "build": "vite build",
    "dev": "vite",
    "dev:fake": "PARFOCAL_PUBLIC_APP_ENV=dev PARFOCAL_PUBLIC_FAKE_API=all vite",
    "test:browser": "playwright test",
    "shot": "node e2e/shot.ts"
  },
  "imports": {
    "#*": "./src/*"
  },
  "dependencies": {
    "@parfocal/api-client": "workspace:*",
    "@parfocal/tokens": "workspace:*",
    "@parfocal/ui": "workspace:*",
    "@parfocal/viewer-engine": "workspace:*",
    "@tanstack/react-query": "5.104.1",
    "@tanstack/react-router": "1.170.46",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@babel/core": "8.0.10",
    "@parfocal/golden-images": "workspace:*",
    "@parfocal/typescript-config": "workspace:*",
    "@playwright/test": "1.64.0",
    "@rolldown/plugin-babel": "0.2.4",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-plugin": "1.168.48",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "babel-plugin-react-compiler": "1.0.0",
    "msw": "3.0.3",
    "tailwindcss": "4.3.3",
    "vite": "8.3.3"
  }
}
