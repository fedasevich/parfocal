{
  "name": "@parfocal/web",
  "description": "The pathologist web app (React SPA)",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.src.json && tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p tsconfig.node.json",
    "test": "node --test --experimental-test-coverage --test-coverage-include=\"src/**\" --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage.lcov \"test/**/*.test.ts\"",
    "build": "vite build",
    "i18n:extract": "lingui extract --clean",
    "analyze": "PARFOCAL_PUBLIC_APP_ENV=prod vite build --mode analyze",
    "dev": "vite",
    "dev:fake": "PARFOCAL_PUBLIC_APP_ENV=dev PARFOCAL_PUBLIC_FAKE_API=all vite",
    "test:browser": "playwright test",
    "bench:hover": "playwright test -c playwright.hover.config.ts",
    "bench:region": "playwright test -c playwright.region.config.ts",
    "smoke": "playwright test -c playwright.smoke.config.ts",
    "test:memory": "playwright test -c playwright.memory.config.ts",
    "gpu-timing": "pnpm --filter @parfocal/viewer-engine gpu-timing",
    "shot": "node e2e/shot.ts"
  },
  "imports": {
    "#*": "./src/*"
  },
  "dependencies": {
    "@lingui/core": "6.11.0",
    "@lingui/message-utils": "6.11.0",
    "@lingui/react": "6.11.0",
    "@parfocal/api-client": "workspace:*",
    "@parfocal/edge": "workspace:*",
    "@parfocal/tokens": "workspace:*",
    "@parfocal/ui": "workspace:*",
    "@parfocal/viewer-engine": "workspace:*",
    "@tanstack/react-query": "5.104.1",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-table": "9.3.1",
    "@tanstack/react-virtual": "3.14.25",
    "@uppy/aws-s3": "6.3.0",
    "@uppy/core": "6.3.0",
    "clipper2-ts": "2.0.1-18",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@babel/core": "8.0.10",
    "@cloudflare/vite-plugin": "1.69.1",
    "@lingui/babel-plugin-lingui-macro": "6.11.0",
    "@lingui/cli": "6.11.0",
    "@lingui/format-po": "6.11.0",
    "@lingui/vite-plugin": "6.11.0",
    "@parfocal/golden-images": "workspace:*",
    "@parfocal/test-fixtures": "workspace:*",
    "@parfocal/typescript-config": "workspace:*",
    "@parfocal/upload-spike": "workspace:*",
    "@playwright/test": "1.65.1",
    "@rolldown/plugin-babel": "0.2.4",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-plugin": "1.168.48",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "babel-plugin-react-compiler": "1.0.0",
    "msw": "3.0.3",
    "rollup-plugin-visualizer": "7.1.2",
    "tailwindcss": "4.3.3",
    "vite": "8.3.3"
  },
  "coverage": {
    "lines": 40
  }
}
