{
  "name": "@parfocal/deploy",
  "description": "Modal app definitions, Neon branches and the deploy steps CI runs",
  "private": true,
  "scripts": {
    "typecheck": "uv run --package parfocal-deploy basedpyright",
    "test": "uv run --package parfocal-deploy pytest tests -q --cov=parfocal_deploy --cov-report=lcov:coverage.lcov",
    "deploy": "uv run --package parfocal-deploy python -m parfocal_deploy.deploy",
    "smoke": "uv run --package parfocal-deploy python -m parfocal_deploy.smoke",
    "bootstrap": "uv run --package parfocal-deploy python -m parfocal_deploy.bootstrap",
    "rotate": "uv run --package parfocal-deploy python -m parfocal_deploy.rotate",
    "costs": "uv run --package parfocal-deploy python -m parfocal_deploy.costs",
    "preview": "uv run --package parfocal-deploy python -m parfocal_deploy.preview"
  },
  "dependencies": {
    "@parfocal/api": "workspace:*",
    "@parfocal/ingest": "workspace:*",
    "@parfocal/ml": "workspace:*",
    "@parfocal/py-common": "workspace:*"
  },
  "coverage": {
    "lines": 66
  }
}
