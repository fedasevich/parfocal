{
  "name": "@parfocal/viewer-engine",
  "description": "Framework-free viewer engine: camera, tiles, overlays, workers",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./viv": "./src/viv/index.ts",
    "./draw-constants": "./src/overlay/draw-constants.ts",
    "./sam-prompt": "./src/sam/smart-prompt.ts",
    "./heap-trend": "./src/memory/heap-trend.ts",
    "./instanseg": "./src/instanseg/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.src.json && tsc --noEmit -p tsconfig.worker.json && tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p tsconfig.browser.json",
    "test": "node --test --experimental-test-coverage --test-coverage-include=\"src/**\" --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage.lcov \"test/**/*.test.ts\"",
    "test:browser": "playwright test",
    "test:browsers": "playwright test -c playwright.browsers.config.ts",
    "test:memory": "playwright test -c playwright.memory.config.ts",
    "test:hidden-tab-hardware": "PARFOCAL_GPU=hardware playwright test -c playwright.hardware.config.ts",
    "gpu-timing": "playwright test -c playwright.gpu.config.ts",
    "bench:j2k": "playwright test -c playwright.j2k.config.ts",
    "bench:frames": "playwright test -c playwright.frame.config.ts frame-budgets",
    "bench:routes": "playwright test -c playwright.frame.config.ts route-head-to-head",
    "bench:sam": "playwright test -c playwright.sam.config.ts sam-variants",
    "bench:instanseg": "playwright test -c playwright.sam.config.ts instanseg",
    "bench:type-learner": "node sam-bench/type-learner-same-images.ts",
    "parity:fetch": "node sam-bench/fetch-parity.ts",
    "parity:sam": "playwright test -c playwright.sam.config.ts sam-parity",
    "smoke:smart-select": "playwright test -c playwright.sam.config.ts smart-select-accuracy",
    "traces:record": "vite browser/page --open /trace-recorder.html"
  },
  "imports": {
    "#*": "./src/*"
  },
  "devDependencies": {
    "@parfocal/edge": "workspace:*",
    "@parfocal/latency-proxy": "workspace:*",
    "@parfocal/test-fixtures": "workspace:*",
    "@parfocal/typescript-config": "workspace:*",
    "@playwright/test": "1.65.1",
    "@types/pngjs": "6.0.5",
    "pngjs": "7.0.0",
    "vite": "8.3.3"
  },
  "dependencies": {
    "@cornerstonejs/codec-openjpeg": "1.3.6",
    "@deck.gl/core": "9.4.0",
    "@deck.gl/extensions": "9.4.0",
    "@deck.gl/geo-layers": "9.4.0",
    "@deck.gl/layers": "9.4.0",
    "@hms-dbmi/viv": "0.23.0",
    "@luma.gl/constants": "9.4.2",
    "@luma.gl/core": "9.4.2",
    "@luma.gl/engine": "9.4.2",
    "@luma.gl/shadertools": "9.4.2",
    "@luma.gl/webgl": "9.4.2",
    "@luma.gl/webgpu": "9.4.2",
    "@math.gl/polygon": "4.1.0",
    "geotiff": "3.0.5",
    "onnxruntime-web": "1.31.1",
    "zarrita": "0.7.5"
  },
  "coverage": {
    "lines": 88
  }
}
