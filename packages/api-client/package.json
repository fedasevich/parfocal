{
  "name": "@parfocal/api-client",
  "description": "Typed API client generated from the backend OpenAPI schema",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./fake": "./src/fake/index.ts",
    "./fake/browser": "./src/fake/browser.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.src.json && tsc --noEmit -p tsconfig.test.json",
    "test": "node --test \"test/**/*.test.ts\"",
    "generate": "orval --config orval.config.ts && node scripts/add-import-extensions.ts src/generated/api.msw.ts && biome check --write src/generated"
  },
  "imports": {
    "#*": "./src/*"
  },
  "devDependencies": {
    "@parfocal/typescript-config": "workspace:*",
    "@types/react": "19.3.0",
    "ajv": "8.20.0",
    "orval": "8.40.0",
    "react": "19.3.1"
  },
  "dependencies": {
    "@faker-js/faker": "10.6.0",
    "@tanstack/react-query": "5.104.1",
    "msw": "3.0.3",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "react": "^19.3.0"
  }
}
