{
  "name": "@parfocal/api-client",
  "description": "Typed API client generated from the backend OpenAPI schema",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.src.json && tsc --noEmit -p tsconfig.test.json",
    "test": "node --test \"test/**/*.test.ts\""
  },
  "imports": {
    "#*": "./src/*"
  },
  "devDependencies": {
    "@parfocal/typescript-config": "workspace:*"
  }
}
