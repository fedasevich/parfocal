{
  "name": "@parfocal/upload-spike",
  "description": "STACK-039 spike: resumable S3 multipart uploads with Uppy over a throttled link that is cut mid-upload",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.src.json && tsc --noEmit -p tsconfig.test.json",
    "test": "node --test \"test/**/*.test.ts\"",
    "spike": "node scripts/spike.ts"
  },
  "imports": {
    "#*": "./src/*"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.1160.0",
    "@aws-sdk/s3-request-presigner": "3.1160.0",
    "@parfocal/latency-proxy": "workspace:*",
    "@parfocal/typescript-config": "workspace:*",
    "@playwright/test": "1.64.0",
    "uppy": "6.0.5"
  }
}
