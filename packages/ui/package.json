{
  "name": "@parfocal/ui",
  "description": "Shared React components built on the design tokens",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./globals.css": "./src/styles/globals.css",
    "./components/*": "./src/components/*.tsx",
    "./hooks/*": "./src/hooks/*.ts",
    "./lib/*": "./src/lib/*.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.src.json && tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p tsconfig.node.json",
    "test": "node --test \"test/**/*.test.ts\"",
    "test:browser": "storybook build --quiet && playwright test",
    "storybook": "storybook dev --port 6006",
    "build-storybook": "storybook build",
    "shadcn:add": "shadcn add --yes",
    "shadcn:adopt": "node scripts/adopt.ts"
  },
  "imports": {
    "#*": "./src/*"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@parfocal/tokens": "workspace:*",
    "@xstate/react": "6.1.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.1",
    "lucide-react": "1.66.0",
    "react-day-picker": "10.0.2",
    "shadcn": "4.23.0",
    "tw-animate-css": "1.4.0",
    "xstate": "5.33.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@babel/core": "8.0.10",
    "@parfocal/api-client": "workspace:*",
    "@parfocal/typescript-config": "workspace:*",
    "@playwright/test": "1.64.0",
    "@rolldown/plugin-babel": "0.2.4",
    "@storybook/addon-a11y": "10.6.5",
    "@storybook/addon-themes": "10.6.5",
    "@storybook/react-vite": "10.6.5",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "5.104.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "babel-plugin-react-compiler": "1.0.0",
    "msw": "3.0.3",
    "msw-storybook-addon": "3.0.3",
    "oxc-parser": "0.156.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "storybook": "10.6.5",
    "tailwindcss": "4.3.3",
    "vite": "8.3.3"
  },
  "peerDependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
