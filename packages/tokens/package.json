{
  "name": "@parfocal/tokens",
  "description": "Design tokens as CSS custom properties and TypeScript constants",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./tokens.css": "./src/tokens.css",
    "./theme.css": "./src/theme.css",
    "./fonts.css": "./src/fonts.css",
    "./type-scale-lint": "./src/type-scale-lint.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.src.json && tsc --noEmit -p tsconfig.test.json",
    "test": "node --test --experimental-test-coverage --test-coverage-include=\"src/**\" --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage.lcov \"test/**/*.test.ts\"",
    "colour-check": "node tools/colour-check.ts",
    "colour-check:sample": "uv run --package parfocal-ingest python tools/sample-he-pixels.py"
  },
  "imports": {
    "#*": "./src/*"
  },
  "devDependencies": {
    "@parfocal/typescript-config": "workspace:*"
  },
  "coverage": {
    "lines": 95
  }
}
