{
  "name": "@parfocal/tokens",
  "description": "Design tokens as CSS custom properties and TypeScript constants",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./tokens.css": "./src/tokens.css",
    "./theme.css": "./src/theme.css",
    "./fonts.css": "./src/fonts.css",
    "./type-scale-lint": "./src/type-scale-lint.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.src.json && tsc --noEmit -p tsconfig.test.json",
    "test": "node --test \"test/**/*.test.ts\""
  },
  "imports": {
    "#*": "./src/*"
  },
  "devDependencies": {
    "@parfocal/typescript-config": "workspace:*"
  }
}
