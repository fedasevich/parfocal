{
  "$schema": "https://biomejs.dev/schemas/2.6.7/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "maxSize": 4194304,
    "includes": [
      "**",
      "!**/.terraform.lock.hcl",
      "!packages/api-client/openapi.json",
      "!apps/web/src/routeTree.gen.ts",
      "!packages/api-client/src/settings/catalogue.generated.ts",
      "!docs/design",
      "!packages/test-fixtures/model-results"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "rules": {
      "preset": "recommended",
      "correctness": {
        "usePlaywrightValidDescribeCallback": "off",
        "noComponentHookFactories": "off"
      },
      "a11y": {
        "noLabelWithoutControl": {
          "level": "error",
          "options": {
            "inputComponents": ["Switch", "Checkbox", "RadioGroupItem"]
          }
        }
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "markdown": {
    "formatter": { "enabled": false },
    "linter": { "enabled": false }
  },
  "yaml": {
    "formatter": { "enabled": false },
    "linter": { "enabled": false }
  },
  "overrides": [
    {
      "includes": ["packages/api-client/src/generated/**"],
      "linter": { "rules": { "suspicious": { "noConfusingVoidType": "off" } } }
    },
    {
      "includes": ["apps/web/e2e/**", "apps/web/test/**"],
      "linter": {
        "rules": {
          "performance": { "useDomNodeTextContent": "off" },
          "style": { "noNonNullAssertion": "off" }
        }
      }
    },
    {
      "includes": ["scripts/board.html"],
      "linter": { "rules": { "style": { "noDescendingSpecificity": "off" } } }
    },
    {
      "includes": ["packages/ui/src/components/**"],
      "linter": {
        "rules": {
          "a11y": {
            "useSemanticElements": "off",
            "useKeyWithClickEvents": "off",
            "noLabelWithoutControl": "off"
          },
          "suspicious": {
            "noArrayIndexKey": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/tokens/src/tokens.css"],
      "linter": {
        "rules": {
          "complexity": {
            "noImportantStyles": "off"
          }
        }
      }
    }
  ]
}
