{
  "uid": "parfocal-overview",
  "title": "Parfocal overview",
  "tags": ["parfocal", "slo"],
  "timezone": "utc",
  "schemaVersion": 39,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "logs",
        "type": "datasource",
        "query": "loki",
        "label": "Logs"
      }
    ]
  },
  "description": "availability: 99.5 percent of API requests end without a server error; tile-latency: 95 percent of tile fetches finish within 60 ms at the edge; ingest-time: 95 percent of uploaded slides are ready to view within 10 minutes; pre-read-time: 95 percent of AI pre-reads are ready within 60 minutes of the slide being ready",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Requests that did not fail",
      "description": "api: sli.api.request",
      "datasource": {
        "type": "loki",
        "uid": "${logs}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${logs}"
          },
          "expr": "sum(count_over_time({service_name=~\".+\"} | event=\"sli.api.request\" | ok=`true` [5m])) / sum(count_over_time({service_name=~\".+\"} | event=\"sli.api.request\" [5m]))"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Request time p95",
      "description": "api: sli.api.request",
      "datasource": {
        "type": "loki",
        "uid": "${logs}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${logs}"
          },
          "expr": "quantile_over_time(0.95, {service_name=~\".+\"} | event=\"sli.api.request\" | unwrap duration_ms [5m]) by (service_name)"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Tiles within 60 ms",
      "description": "tiles: sli.tile.fetch",
      "datasource": {
        "type": "loki",
        "uid": "${logs}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${logs}"
          },
          "expr": "sum(count_over_time({service_name=~\".+\"} | event=\"sli.tile.fetch\" | ok=`true` [5m])) / sum(count_over_time({service_name=~\".+\"} | event=\"sli.tile.fetch\" [5m]))"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Slides ready within 10 minutes",
      "description": "ingest: slo.status",
      "datasource": {
        "type": "loki",
        "uid": "${logs}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${logs}"
          },
          "expr": "max by (slo) ({service_name=~\".+\"} | event=\"slo.status\" | slo=`ingest-time` | unwrap good_permille [15m])"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Pre-reads ready within 60 minutes",
      "description": "gpu: slo.status",
      "datasource": {
        "type": "loki",
        "uid": "${logs}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${logs}"
          },
          "expr": "max by (slo) ({service_name=~\".+\"} | event=\"slo.status\" | slo=`pre-read-time` | unwrap good_permille [15m])"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Error budget burn over 1 hour",
      "description": "workers: slo.status",
      "datasource": {
        "type": "loki",
        "uid": "${logs}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${logs}"
          },
          "expr": "max by (slo) ({service_name=~\".+\"} | event=\"slo.status\" | unwrap burn_tenths [15m])"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Viewer frame time p95",
      "description": "viewer: rum.viewer.frames",
      "datasource": {
        "type": "loki",
        "uid": "${logs}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${logs}"
          },
          "expr": "quantile_over_time(0.5, {service_name=~\".+\"} | event=\"rum.viewer.frames\" | unwrap p95_ms [5m]) by (service_name)"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Long frames per minute",
      "description": "viewer: rum.viewer.frames",
      "datasource": {
        "type": "loki",
        "uid": "${logs}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${logs}"
          },
          "expr": "sum(sum_over_time({service_name=~\".+\"} | event=\"rum.viewer.frames\" | unwrap long_frames [1m]))"
        }
      ]
    }
  ]
}
