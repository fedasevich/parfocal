{
  "$schema": "https://turborepo.com/schema.json",
  "agentGuidance": false,
  "globalDependencies": [
    ".node-version",
    ".python-version",
    "pyproject.toml",
    "uv.lock",
    "perf-budgets.json",
    "scripts/perf-budgets.ts"
  ],
  "globalEnv": ["APP_ENV"],
  "tasks": {
    "topo": {
      "dependsOn": ["^topo"]
    },
    "typecheck": {
      "dependsOn": ["topo"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["topo"],
      "outputs": [],
      "env": ["PARFOCAL_REQUIRE_FIXTURES"],
      "passThroughEnv": ["PARFOCAL_FIXTURES_DIR", "XDG_CACHE_HOME"]
    },
    "test:browser": {
      "dependsOn": ["topo"],
      "cache": false,
      "passThroughEnv": [
        "PARFOCAL_REQUIRE_FIXTURES",
        "PARFOCAL_FIXTURES_DIR",
        "XDG_CACHE_HOME",
        "GOLDEN_UPDATE",
        "GOLDEN_MEASURE",
        "PAN_RTT_MS",
        "PAN_BANDWIDTH"
      ]
    }
  }
}
