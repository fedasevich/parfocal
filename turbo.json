{
  "$schema": "https://turborepo.com/schema.json",
  "agentGuidance": false,
  "globalDependencies": [".node-version", ".python-version", "pyproject.toml", "uv.lock"],
  "globalEnv": ["APP_ENV"],
  "tasks": {
    "topo": {
      "dependsOn": ["^topo"]
    },
    "typecheck": {
      "dependsOn": ["topo"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["topo"],
      "outputs": []
    }
  }
}
