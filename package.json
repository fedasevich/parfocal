{
  "name": "parfocal",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "prepare": "lefthook install",
    "test": "turbo run test",
    "test:guards": "node --test \"scripts/*.test.ts\"",
    "typecheck": "turbo run typecheck && tsc --noEmit -p scripts",
    "check": "biome check . && oxlint --type-aware && uv run ruff check && uv run ruff format --check",
    "secrets": "betterleaks git . --redact --no-banner",
    "format": "biome format --write . && uv run ruff format"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@parfocal/typescript-config": "workspace:*",
    "@types/node": "^26.0.0",
    "lefthook": "2.1.17",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2003",
    "turbo": "2.11.7",
    "typescript": "7.0.2"
  }
}
