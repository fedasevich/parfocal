    "test:guards": "node --test \"scripts/*.test.ts\""
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^26.0.0",
    "turbo": "2.11.7",
    "typescript": "7.0.2"
  }
}
